{
  "buildCommand": "bun run build",
  "framework": "astro",
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/advertiser",
      "destination": "/indoor-billboards/screen-advertising",
      "permanent": true
    },
    {
      "source": "/advertiser/",
      "destination": "/indoor-billboards/screen-advertising",
      "permanent": true
    },
    {
      "source": "/advertise",
      "destination": "/indoor-billboards/screen-advertising",
      "permanent": true
    },
    {
      "source": "/advertise/",
      "destination": "/indoor-billboards/screen-advertising",
      "permanent": true
    },
    {
      "source": "/host",
      "destination": "/indoor-billboards/become-a-venue-partner",
      "permanent": true
    },
    {
      "source": "/host/",
      "destination": "/indoor-billboards/become-a-venue-partner",
      "permanent": true
    },
    {
      "source": "/locations",
      "destination": "/indoor-billboards/locations",
      "permanent": true
    },
    {
      "source": "/locations/",
      "destination": "/indoor-billboards/locations",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/solutions",
      "permanent": true
    }
  ]
}
